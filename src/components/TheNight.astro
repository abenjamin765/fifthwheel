<!-- Three stops: drinks, dinner, dessert. -->
<section class="walk">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">The night</p>
      <h2>Three stops. One neighborhood.<br />More to the table.</h2>
      <p>Curated restaurants. Great conversation. You just show up.</p>
    </div>
    <div class="stops">
      <div class="stop">
        <span class="n">FIRST</span>
        <h3>Drinks</h3>
        <p>Meet the group at a handpicked spot.</p>
        <span class="time">About 30 minutes</span>
      </div>
      <div class="stop">
        <span class="n">SECOND</span>
        <h3>Dinner</h3>
        <p>
          Share a meal at a curated restaurant a few doors down. After dinner,
          vote in the app who you want to have dessert with.
        </p>
        <span class="time">About 1 hour</span>
      </div>
      <div class="stop">
        <span class="n">THIRD</span>
        <h3>Dessert</h3>
        <p>Head to the final spot with your match.</p>
        <span class="time">About 30 minutes</span>
      </div>
    </div>
  </div>
</section>
